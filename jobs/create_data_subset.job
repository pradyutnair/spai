#!/bin/bash

#SBATCH --gpus=1
#SBATCH --job-name=create_data_subset
#SBATCH --partition=gpu_h100
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=outputs/create_data_subset_%A.out

echo "🐍 Starting Conda environment setup on $(hostname) at $(date)"

# Load required modules
module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1
source activate spai

# Set constants
HOME_DIR="/home/azywot1/azywot/spai"
FRACTION=0.5  # 20% of the dataset
FILE_PATH="/scratch-shared/dl2_all_data/ldm_train_val_trainset.csv"

cd "$HOME_DIR" || exit
echo "Working directory: $(pwd)"


# --- Set Python Environment ---
cd "$ROOT_DIR"
export PYTHONPATH=$PYTHONPATH:"$ROOT_DIR"
export NCCL_DEBUG=INFO
export CUDA_LAUNCH_BLOCKING=0

# ✅ Check CUDA availability
python - <<'EOF'
import torch
print("CUDA available?", torch.cuda.is_available())
print("Device name:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
EOF


# Subsample the dataset
echo "📊 Subsampling $FRACTION of the dataset from $FILE_PATH..."
python -c "
import pandas as pd
import os

fraction = $FRACTION
input_path = '$FILE_PATH'
output_path = f\"{input_path.rsplit('.', 1)[0]}_{int(fraction * 100)}pct.csv\"

df = pd.read_csv(input_path)
df_sub = df.sample(frac=fraction, random_state=42)
df_sub.to_csv(output_path, index=False)

# Set permissions to 777
os.chmod(output_path, 0o777)

print(f\"Saved {fraction:.0%} subsample to {output_path} and set permissions to 777\")
"