#!/bin/bash
#SBATCH --job-name=spai_train
#SBATCH --output=spai_train_%A.out
#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=2-00:00:00
#SBATCH --mem=180G
#SBATCH --hint=nomultithread

# --- Environment Setup ---
echo "✅ Job started at: $(date)"
echo "✅ Running on node: $(hostname)"
echo "✅ CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1
source activate spai

ROOT_DIR="$HOME/spai"
ENV_FILE="${ROOT_DIR}/.env"

# --- Job Info ---
echo "--- JOB PARAMETERS ---"
echo "ROOT_DIR: $ROOT_DIR"
echo "CONFIG_PATH: $CONFIG_PATH"
echo "PRETRAINED_PATH: $PRETRAINED_PATH"
echo "DATA_PATH: $DATA_PATH"
echo "OUTPUT_DIR: $OUTPUT_DIR"
echo "BATCH_SIZE: $BATCH_SIZE"
echo "NUM_WORKERS: $NUM_WORKERS"
echo "----------------------"

# --- Set Python Environment ---
cd "$ROOT_DIR"
export PYTHONPATH=$PYTHONPATH:"$ROOT_DIR"
export NCCL_DEBUG=INFO
export CUDA_LAUNCH_BLOCKING=0

# ✅ Check CUDA availability
python - <<'EOF'
import torch
print("CUDA available?", torch.cuda.is_available())
print("Device name:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
EOF

# --- Execute the Training ---
echo "🚀 Starting Python training script..."
python -m spai train \
  --cfg "./configs/spai.yaml" \
  --batch-size 72 \
  --pretrained "./weights/mfm_pretrain_vit_base.pth" \
  --output "./output/train" \
  --data-path "/scratch-shared/dl2_all_data/ldm_train_val_trainset_20pct.csv" \
  --tag "spai" \
  --amp-opt-level "O0" \
  --data-workers 8 \
  --save-all \
  --opt "DATA.VAL_BATCH_SIZE" "256" \
  --opt "MODEL.FEATURE_EXTRACTION_BATCH" "400" \
  --opt "DATA.TEST_PREFETCH_FACTOR" "1"

echo "✅ Job finished at: $(date)"